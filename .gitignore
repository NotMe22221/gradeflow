# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# local database (synthetic demo data only, recreated by `npm run seed`)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# generated prisma client (recreated on `npm install`)
/src/generated/

# env files - never commit secrets
.env
.env*.local
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
/test-results/
/playwright-report/

# Address of the local Postgres dev server (written by scripts/local-db.mjs)
/prisma/.local-database-url
