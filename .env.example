# Copy to .env (optional). GradeFlow runs with zero configuration.

# Local SQLite database. Default: file:./prisma/dev.db
# DATABASE_URL="file:./prisma/dev.db"

# Signs the demo session cookie. Set any long random string outside local demos.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. When set, the AI first pass uses the Claude API.
# When unset, a local deterministic "demo grader" is used and labelled in the UI.
# This key is read on the server only. Never commit it.
# ANTHROPIC_API_KEY=""

# Optional overrides for the Claude grader.
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_EFFORT="medium"
