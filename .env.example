# Copy to .env (optional). GradeFlow runs with zero configuration.

# Local SQLite database. Default: file:./prisma/dev.db
# DATABASE_URL="file:./prisma/dev.db"

# Signs the session cookie. Set any long random string outside local demos.
# Required (16+ characters) in production once GRADEFLOW_DEMO_LOGIN=off.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Session cookies follow the request protocol (Secure over HTTPS).
# Force with true/false, e.g. false to demo `npm start` over plain HTTP on a LAN.
# SESSION_COOKIE_SECURE=""

# One-click demo sign-in on the landing page and the demo account switcher.
# GRADEFLOW_DEMO_LOGIN="on"

# Optional. When set, the AI first pass uses the Claude API.
# When unset, a local deterministic "demo grader" is used and labelled in the UI.
# This key is read on the server only. Never commit it.
# ANTHROPIC_API_KEY=""

# Optional overrides for the Claude grader.
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_EFFORT="medium"
