# Copy to .env.local (optional). GradeSmart AI runs with zero configuration.
# Next.js and the Prisma CLI both read .env.local, then .env.
# Keys are read on the server only. Never commit them.

# --- AI engines (optional) ----------------------------------------------------
# OpenAI powers the camera grader and answer-key reader (gpt-4o, vision) and the
# goal planner and conference briefs (gpt-4o-mini). Model routing is fixed in
# src/lib/ai/openai.ts. Without a key, labelled demo engines run locally.
# OPENAI_API_KEY=""

# Claude powers the AI first pass on typed essays. Without a key, the labelled
# demo grader runs.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_EFFORT="medium"

# --- App ----------------------------------------------------------------------
# Local SQLite database. Default: file:./prisma/dev.db
# DATABASE_URL="file:./prisma/dev.db"

# Signs the session cookie. Set any long random string outside local demos.
# Required (16+ characters) in production once GRADESMART_DEMO_LOGIN=off.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Session cookies are Secure, except over plain HTTP to localhost or a private
# LAN address (so a phone on your network can open the demo). Behind a TLS
# proxy, send X-Forwarded-Proto. Force with true/false.
# SESSION_COOKIE_SECURE=""

# One-click demo sign-in on the landing page and the demo account switcher.
# GRADESMART_DEMO_LOGIN="on"
