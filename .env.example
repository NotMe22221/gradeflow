# Copy to .env.local (optional). Markwise runs locally with zero configuration.
# Next.js and the Prisma CLI both read .env.local, then .env.
# Keys are read on the server only. Never commit them.

# --- AI engines (optional) ----------------------------------------------------
# Claude powers every AI feature: the first pass on typed essays, the camera
# grader and answer-key reader (photos), and the conference briefs and goal
# planner. Without a key, labelled demo engines run locally.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-5-5"
# ANTHROPIC_EFFORT="medium"

# Optional. When set, OpenAI takes over the photo features (gpt-4o) and the
# briefs and goal planner (gpt-4o-mini); essays stay on Claude. The choice is
# made in one place: engineFor() in src/lib/ai/engines.ts.
# OPENAI_API_KEY=""

# --- Live AI limits (optional) --------------------------------------------------
# Every paid call goes through one usage guard (src/lib/ai/usage.ts). A call
# past a cap is never sent; the page says which limit was hit. Spend is
# estimated from list prices (src/lib/ai/pricing.ts).
# AI_KILL_SWITCH="1"               # every feature runs its labelled demo engine
# AI_LIMIT_PER_SESSION_HOUR="20"
# AI_LIMIT_PER_IP_HOUR="60"
# AI_LIMIT_PER_DAY="400"           # whole site, per UTC day
# AI_DAILY_BUDGET_USD="2"          # whole site, per UTC day

# --- App ----------------------------------------------------------------------
# Postgres. Leave unset locally: `npm run dev` and `npm run seed` start Prisma's
# local Postgres server for you. On a host (e.g. Vercel + Neon), the host sets
# these. DATABASE_URL is the app's (pooled) connection; DATABASE_URL_UNPOOLED
# (or DIRECT_URL) is a direct connection for schema changes. Neon URLs need
# ?sslmode=require (Neon's own URLs include it).
# DATABASE_URL="postgres://user:password@host/db?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED="postgres://user:password@host/db?sslmode=require&channel_binding=require"
# `npm run seed` only ever erases the local dev server. With DATABASE_URL set
# to anything else it stops without changing anything (there is no override).

# Vercel only, Preview environment only: lets Preview builds push the schema
# and seed an empty database. Set it only when Neon gives each preview its own
# database branch; otherwise previews share production's database, and only
# Production builds change it.
# ALLOW_PREVIEW_DB_CHANGES="1"

# Signs the session cookie. Set any long random string outside local demos.
# Required (16+ characters) in production once MARKWISE_DEMO_LOGIN=off.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Session cookies are Secure, except over plain HTTP to localhost or a private
# LAN address (so a phone on your network can open the demo). Behind a TLS
# proxy, send X-Forwarded-Proto. Force with true/false.
# SESSION_COOKIE_SECURE=""

# One-click demo sign-in on the landing page and the demo account switcher.
# MARKWISE_DEMO_LOGIN="on"
